# Python
backend/venv/
.venv/
__pycache__/
*.pyc
backend/data/*.db

# Recorded footage / captured frames (never commit surveillance video)
backend/app/storage/**
!backend/app/storage/.gitkeep

# YOLO model weights (auto-downloaded on first run, don't commit binaries)
backend/models/*.pt

# Node / frontend
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
.vscode/
.idea/

# Generated demo camera videos (python scripts/make_demo_videos.py)
backend/sample_videos/*
!backend/sample_videos/.gitkeep

# Face recognition models (auto-downloaded)
backend/models/*.onnx

# Secrets and local config — never commit
backend/.env
backend/data/.secret_key
