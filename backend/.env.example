# Copy this file to  backend/.env  and edit. The .env file is git-ignored; NEVER commit it.
# Every setting also works as a plain environment variable.

# ----------------------------------------------------------------- Accounts
# Used only on the very FIRST start (when no users exist yet) to create the
# administrator. If ADMIN_PASSWORD is empty, a random one is generated and
# printed once in the server log (not allowed in REMOTE_MODE).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs session tokens. If empty, a key is generated into data/.secret_key.
# Required (32+ characters) in REMOTE_MODE:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ------------------------------------------------- Network / remote access
# Leave everything below as-is for local use (http://localhost:5173).
# See README -> "Remote monitoring" before changing any of it.

# Comma-separated browser origins allowed to call the API with cookies. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host names this server will answer to (blocks forged Host headers).
ALLOWED_HOSTS=localhost,127.0.0.1

# REMOTE_MODE=true makes the server REFUSE TO START unless the setup is safe for a
# network: ALLOWED_HOSTS lists your real host name, CORS origins are https,
# SECRET_KEY is set, ADMIN_PASSWORD is strong. It also forces Secure cookies,
# enables HSTS and turns the API docs off.
REMOTE_MODE=false
PUBLIC_URL=
# Serve the built dashboard (frontend/dist) from this server too: one origin, one port.
SECURITY__SERVE_FRONTEND=false
# Only behind a reverse proxy you control (trusts X-Forwarded-For / -Proto):
SECURITY__TRUST_PROXY_HEADERS=false

# ----------------------------------------------------------------- Alerts
# Seconds a camera must be offline before an alert is raised.
ALERTS__CAMERA_OFFLINE_GRACE_SECONDS=20

# Suspicious-activity rules (simple heuristics, see README)
ACTIVITY__LOITERING_ENABLED=true
ACTIVITY__LOITER_SECONDS=60
ACTIVITY__AFTER_HOURS_ENABLED=false
ACTIVITY__AFTER_HOURS_START=23:00
ACTIVITY__AFTER_HOURS_END=05:00

# ------------------------------------------------------- Email notifications
# Off until enabled. Use an app-specific password, never your main one.
EMAIL__ENABLED=false
EMAIL__HOST=smtp.example.com
EMAIL__PORT=587
EMAIL__USE_STARTTLS=true
EMAIL__USERNAME=
EMAIL__PASSWORD=
EMAIL__FROM_ADDR=cctv@example.com
EMAIL__TO_ADDRS=you@example.com,family@example.com
# Only alerts at or above this severity are emailed: low | medium | high | critical
EMAIL__MIN_SEVERITY=high
# Snapshots can show faces. Leave off unless you want them in your mailbox.
EMAIL__ATTACH_SNAPSHOT=false

# ------------------------------------------------------------- Night mode
NIGHT__ENABLED=true
# Also brighten what YOU see live (recordings are never enhanced). Off = honest picture.
NIGHT__ENHANCE_LIVE_VIEW=false
